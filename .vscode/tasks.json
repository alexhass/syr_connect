{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Pytest",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m pytest --timeout=10 tests",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Pytest (WSL)",
      "type": "process",
      "command": "${env:WINDIR}\\System32\\wsl.exe",
      "args": [
        "--distribution",
        "Ubuntu",
        "--exec",
        "bash",
        "-lc",
        "workspace_path=\"$(wslpath -u '${workspaceFolder}')\" && cd \"$workspace_path\" && \"$HOME/.venvs/syr_connect/bin/python\" -m pytest --timeout=10 tests"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Pytest (changed tests only)",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m pytest --timeout=10 --picked",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Pytest with Coverage",
      "detail": "Run tests with code coverage report",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m pytest tests --cov=custom_components.syr_connect --cov-report=term-missing --cov-report=html",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Ruff Check",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m ruff check .",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Ruff Format",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m ruff format .",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Mypy Type Check",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m mypy",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Update Dev Requirements",
      "detail": "Install or update pip and requirements-dev.txt to the newest allowed versions",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m pip install --upgrade pip -r requirements-dev.txt",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Update Dev Requirements (WSL)",
      "detail": "Install or update pip and requirements-dev.txt in the WSL venv used by Pytest (WSL)",
      "type": "process",
      "command": "${env:WINDIR}\\System32\\wsl.exe",
      "args": [
        "--distribution",
        "Ubuntu",
        "--exec",
        "bash",
        "-lc",
        "workspace_path=\"$(wslpath -u '${workspaceFolder}')\" && cd \"$workspace_path\" && \"$HOME/.venvs/syr_connect/bin/python\" -m pip install --upgrade pip -r requirements-dev.txt"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Update Dev Environments",
      "detail": "Update the Windows and the WSL development environment",
      "dependsOn": [
        "Update Dev Requirements",
        "Update Dev Requirements (WSL)"
      ],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Pre-commit Run All",
      "type": "shell",
      "command": "pre-commit run --all-files",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ]
}
